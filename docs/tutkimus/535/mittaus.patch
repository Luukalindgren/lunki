+import { it } from 'vitest';
+import { LUNKINJARVI, LUNKINJARVI_BOTTOM } from '../map/lunkinjarvi';
+import { LakeBottom } from '../map/bottom';
+import { WaterBody } from '../map/waterBody';
+it('syvyys', () => {
+  const water = new WaterBody(LUNKINJARVI);
+  const b = new LakeBottom(water, LUNKINJARVI.bounds, LUNKINJARVI_BOTTOM, LUNKINJARVI.reeds, LUNKINJARVI.piers);
+  const bb = LUNKINJARVI.bounds; const min = { x: bb.minX, y: bb.minY }, max = { x: bb.maxX, y: bb.maxY };
+  let n = 0, sum = 0, mx = 0; const hist = new Array(10).fill(0);
+  for (let x = min.x; x < max.x; x += 5) for (let y = min.y; y < max.y; y += 5) {
+    const p = { x, y }; if (!water.isWater(p)) continue;
+    const d = b.depthAt(p); n++; sum += d; mx = Math.max(mx, d); hist[Math.min(9, Math.floor(d))]++;
+  }
+  console.log(`SYV ala=${(n*25/10000).toFixed(1)} ha keski=${(sum/n).toFixed(2)} max=${mx.toFixed(2)} osuudet=${hist.map(h=>(100*h/n).toFixed(0)).join('/')}`);
+});
