+import { it } from 'vitest';
+import { DAYTIME, NATIVE_SPECIES, SPECIES, speciesActivity, type FishConditions } from '../fishing/fish';
+import { DEFAULT_TACKLE } from '../fishing/gear';
+import type { Season } from '../weather/season';
+import { simSpecies } from './lajit';
+
+const TIMES: Record<string, FishConditions> = {
+  päivä: { ...DAYTIME, light: 1, twilight: 0 },
+  hämärä: { ...DAYTIME, light: 0.35, twilight: 1 },
+  yö: { ...DAYTIME, light: 0, twilight: 0 },
+};
+const SEASONS: Season[] = ['spring', 'summer', 'autumn'];
+
+it('aktiivisuus', () => {
+  const ids = [...NATIVE_SPECIES, 'zander' as const];
+  for (const s of SEASONS)
+    for (const [t, c] of Object.entries(TIMES)) {
+      const row = ids.map((id) => {
+        const a = speciesActivity(id, { ...c, season: s });
+        return `${id}=${a.toFixed(2)}`;
+      });
+      console.log(`AKT ${s} ${t} ${row.join(' ')}`);
+    }
+  for (const id of ids) console.log(`LI ${id} lureInterest=${SPECIES[id].lureInterest} abundance=${SPECIES[id].abundance}`);
+});
+
+it('saaliit', () => {
+  const seeds = Number(process.env.SEEDS ?? 4);
+  for (const lure of (process.env.LURE ? [process.env.LURE] : ['spoon', 'jig']) as ('spoon' | 'jig')[])
+    for (const s of (process.env.SEASON ? [process.env.SEASON] : SEASONS) as Season[])
+      for (const [t, c] of Object.entries(TIMES)) {
+        const tot: Record<string, number> = {};
+        for (let k = 0; k < seeds; k++) {
+          const r = simSpecies('normal', 100 + k, 30, {
+            dt: 1 / 20,
+            cond: c,
+            season: s,
+            tackle: { ...DEFAULT_TACKLE, lure, jigWeight: 'g10' },
+          });
+          for (const [id, n] of Object.entries(r)) tot[id] = (tot[id] ?? 0) + n;
+        }
+        console.log(`SAALIS ${lure} ${s} ${t} ${JSON.stringify(tot)}`);
+      }
+}, 3_600_000);
