+import { it } from 'vitest';
+import { PROTO, resetProto, type SpeciesId } from '../fishing/fish';
+import type { Tackle } from '../fishing/gear';
+import { simulateNaiveAngler } from '../fishing/naiveAngler';
+import { skilledEvents, type Style } from './taitava2';
+const M: [string, Partial<Tackle>, Style][] = [['lusikka', { lure: 'spoon' }, 'steady'], ['lippa', { lure: 'spinner', rod: 'light' }, 'steady'], ['vaappu', { lure: 'wobbler' }, 'steady'], ['jigi', { lure: 'jig' }, 'jig']];
+it('vieheet2', () => {
+  PROTO.lures = 'B';
+  const cyp: Record<string, number[]> = {};
+  for (const sp of ['roach', 'bream', 'carp'] as SpeciesId[]) cyp[sp] = M.map(([, t, st]) => { resetProto(); return skilledEvents(sp, 'summer', 22.5, t, st, 30, 9, {}, 'normal').target ?? 0; });
+  const naive: Record<string, number> = {};
+  for (const [o, d] of [['none', 'normal'], ['B', 'normal'], ['none', 'realistic'], ['B', 'realistic']] as const) {
+    PROTO.lures = o;
+    let c = 0;
+    for (const seed of [1000, 1001, 1002]) { resetProto(); c += simulateNaiveAngler(d, seed, 10).caught; }
+    naive[`${o}-${d}`] = c / 30;
+  }
+  console.log('V2', JSON.stringify({ cyp, naive }));
+}, 3_000_000);
