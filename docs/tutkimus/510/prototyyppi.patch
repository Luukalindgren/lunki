+      row.push(`${name}: ${r.follow}/${r.strike}/${r.caught}`);
+    }
+    lines.push(`${sp.padEnd(8)} ${row.join('  ')}`);
+  }
+  console.log('=== syyspaiva (seuraa/iskee/saatu per 30 heittoa)\n' + lines.join('\n'));
+}, 3_000_000);
