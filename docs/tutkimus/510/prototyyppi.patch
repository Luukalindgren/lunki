+/** Tutkimuksen prototyyppi: vaihtoehtojen kytkimet (ei pelin koodia). */
+export const PROTO = {
+  mood: 'none' as 'none' | 'A' | 'B' | 'C',
+  thermal: 'none' as 'none' | 'A' | 'B',
+  lures: 'none' as 'none' | 'A' | 'B',
+};
+/** Syöntijakso: kalan tai parven syöntitila ja ajastin. */
+const moods = new Map<string, { feeding: boolean; until: number }>();
+let protoClock = 0;
+export function resetProto() {
+  moods.clear();
+  deepHomes.clear();
+  protoClock = 0;
+}
+const feedShare = (act: number) => Math.max(0.03, Math.min(0.95, act * 0.6));
+function moodOf(key: string, act: number, rng: Rng): boolean {
+  let m = moods.get(key);
+  if (!m) {
+    m = { feeding: rng.next() < feedShare(act), until: protoClock + rng.range(30, 300) };
+    moods.set(key, m);
+  }
+  if (protoClock >= m.until) {
+    m.feeding = rng.next() < feedShare(act);
+    m.until = protoClock + rng.range(90, 300);
+  }
+  return m.feeding;
+}
+export function moodSnapshot(): Record<string, boolean> {
+  return Object.fromEntries([...moods].map(([k, v]) => [k, v.feeding]));
+}
+/** Syöntikerroin seurata ja iskeä: syövä kala innokkaampi, lepäävä vain näykkii. */
+function moodFactor(f: Fish, act: number, rng: Rng, _dt: number): { follow: number; strike: number } {
+  if (PROTO.mood === 'B' || PROTO.mood === 'C') {
+    const key = PROTO.mood === 'C' ? `sp:${f.species}` : f.school >= 0 ? `s:${f.school}` : `f:${f.id}`;
+    const feeding = moodOf(key, act, rng);
+    return feeding ? { follow: 1.4, strike: 1.4 } : { follow: 0.12, strike: 0.2 };
+  }
+  return { follow: 1, strike: 1 };
+}
+/** Kesän viileä paikka: syvemmän veden kohta kotipaikan lähellä (ilman arpoja). */
+const deepHomes = new Map<number, Vec2>();
+export function thermalHome(f: Fish, world: FishWorld, season: Season | undefined): Vec2 {
+  if (PROTO.thermal !== 'B' || (season ?? DEFAULT_SEASON) !== 'summer') return f.home;
+  const big = f.species === 'pike' && sizeClass(f.species, f.weight) >= 2;
+  if (!big && f.species !== 'burbot') return f.home;
+  const want = f.species === 'pike' ? 3 : 5;
+  let h = deepHomes.get(f.id);
+  if (!h) {
+    h = f.home;
+    let best = world.depthAt(f.home);
+    if (best < want) {
+      outer: for (let r = 4; r <= 60; r += 4)
+        for (let k = 0; k < 16; k++) {
+          const a = (k / 16) * Math.PI * 2;
+          const p = { x: f.home.x + Math.cos(a) * r, y: f.home.y + Math.sin(a) * r };
+          if (!world.isWater(p)) continue;
+          const d = world.depthAt(p);
+          if (d > best) {
+            best = d;
+            h = p;
+          }
+          if (d >= want) break outer;
+        }
+    }
+    deepHomes.set(f.id, h);
+  }
+  return h;
+}
