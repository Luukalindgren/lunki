+import { writeFileSync } from 'node:fs';
+import { LUNKINJARVI, LUNKINJARVI_BOTTOM } from '../map/lunkinjarvi';
+import { LakeBottom } from '../map/bottom';
+import { WaterBody } from '../map/waterBody';
+import { Rng } from '../rng';
+import type { Vec2 } from '../vec2';
+import { daylight } from '../weather/timeOfDay';
+import type { Season } from '../weather/season';
+import { DIFFICULTIES } from '../fishing/difficulty';
+import { DAYTIME, FISH_COUNT, NATIVE_SPECIES, createFishPopulation, sizeClass, stepFishPopulation, type FishConditions, type SpeciesId } from '../fishing/fish';
+
+export const OUT = '/tmp/claude-0/-home-user-lunki/61331341-d7ff-50b0-b325-27f029f4c942/scratchpad/kartta';
+const water = new WaterBody(LUNKINJARVI);
+const bottom = new LakeBottom(water, LUNKINJARVI.bounds, LUNKINJARVI_BOTTOM, LUNKINJARVI.reeds, LUNKINJARVI.piers);
+const world = { isWater: (p: Vec2) => water.isWater(p), depthAt: (p: Vec2) => bottom.depthAt(p) };
+const b = LUNKINJARVI.bounds;
+
+export function exportGrid(cell = 4) {
+  const w = Math.ceil((b.maxX - b.minX) / cell);
+  const h = Math.ceil((b.maxY - b.minY) / cell);
+  const depth: number[] = [];
+  for (let j = 0; j < h; j++)
+    for (let i = 0; i < w; i++) {
+      const p = { x: b.minX + (i + 0.5) * cell, y: b.maxY - (j + 0.5) * cell };
+      depth.push(water.isWater(p) ? Math.round(bottom.depthAt(p) * 10) / 10 : -1);
+    }
+  const reeds = bottom.structures.filter((s) => s.kind === 'reeds' || s.kind === 'weed').map((s) => ({ x: s.pos.x, y: s.pos.y, r: s.radius, kind: s.kind }));
+  writeFileSync(`${OUT}/grid.json`, JSON.stringify({ w, h, cell, bounds: b, depth, reeds }));
+}
+
+export function exportFish(name: string, season: Season, hour: number, minutes = 20, extra: Partial<FishConditions> = {}, species: SpeciesId[] = [...NATIVE_SPECIES]) {
+  const d = daylight(hour, season);
+  const cond: FishConditions = { ...DAYTIME, light: d.light, twilight: d.twilight, season, ...extra };
+  const rng = new Rng(42);
+  const pop = createFishPopulation({ ...world, structures: bottom.structures }, b, rng, FISH_COUNT, species, season);
+  for (let t = 0; t < minutes * 60; t += 0.25) stepFishPopulation(pop, null, world, DIFFICULTIES.normal, rng, 0.25, cond);
+  const fish = pop.fish.map((f) => ({ s: f.species, x: Math.round(f.pos.x), y: Math.round(f.pos.y), d: Math.round(f.depth * 10) / 10, b: Math.round(bottom.depthAt(f.pos) * 10) / 10, c: sizeClass(f.species, f.weight), hx: Math.round(f.home.x), hy: Math.round(f.home.y) }));
+  writeFileSync(`${OUT}/${name}.json`, JSON.stringify({ name, season, hour, fish }));
