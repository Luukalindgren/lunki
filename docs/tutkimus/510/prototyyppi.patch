+const CASES: [SpeciesId, Partial<Tackle>, Style, Season, number][] = [
+  ['perch', { lure: 'jig' }, 'jig', 'summer', 13], ['perch', { lure: 'jig' }, 'jig', 'summer', 22.5], ['perch', { lure: 'jig' }, 'jig', 'summer', 1],
+  ['perch', { lure: 'spinner', rod: 'light' }, 'steady', 'summer', 13], ['perch', { lure: 'spinner', rod: 'light' }, 'steady', 'summer', 1],
+  ['zander', { lure: 'jig' }, 'jig', 'summer', 13], ['zander', { lure: 'jig' }, 'jig', 'summer', 22.5], ['zander', { lure: 'jig' }, 'jig', 'summer', 1],
+  ['burbot', { lure: 'jig' }, 'jig', 'summer', 13], ['burbot', { lure: 'jig' }, 'jig', 'summer', 1], ['burbot', { lure: 'jig' }, 'jig', 'autumn', 1],
+  ['pike', { lure: 'wobbler', leader: true }, 'steady', 'summer', 13], ['pike', { lure: 'wobbler', leader: true }, 'steady', 'summer', 22.5], ['pike', { lure: 'wobbler', leader: true }, 'steady', 'summer', 1], ['pike', { lure: 'wobbler', leader: true }, 'steady', 'autumn', 8],
+  ['roach', { lure: 'jig' }, 'jig', 'summer', 22.5], ['bream', { lure: 'jig' }, 'jig', 'summer', 22.5], ['carp', { lure: 'jig' }, 'jig', 'summer', 22.5],
+  ['roach', { lure: 'spinner', rod: 'light' }, 'steady', 'summer', 13],
+  ['trout', { lure: 'spoon' }, 'steady', 'summer', 13], ['trout', { lure: 'spoon' }, 'steady', 'spring', 13],
+];
+it('realistinen', () => {
+  for (const [sp, t, st, se, h] of CASES) {
+    const r = skilledEvents(sp, se, h, t, st, 30, 9, {}, 'realistic');
+    console.log(`R ${sp} ${t.lure}${t.leader ? '+peruke' : ''} ${se} klo ${h}: seuraa ${r.follow} iskee ${r.strike} kiinni ${r.hooked ?? 0} saatu ${r.caught} (muut iskut ${r.otherStrike ?? 0})`);
+  }
+}, 3_000_000);
diff --git a/packages/shared/src/tutkimus/saalis.test.ts b/packages/shared/src/tutkimus/saalis.test.ts
new file mode 100644
index 0000000..3061782
--- /dev/null
+++ b/packages/shared/src/tutkimus/saalis.test.ts
@@ -0,0 +1,94 @@
+import { it } from 'vitest';
+import { LUNKINJARVI, LUNKINJARVI_BOTTOM } from '../map/lunkinjarvi';
+import { LakeBottom } from '../map/bottom';
+import { WaterBody } from '../map/waterBody';
+import { findLaunchPoint } from '../map/geometry';
+import { Rng } from '../rng';
+import type { Vec2 } from '../vec2';
+import { daylight } from '../weather/timeOfDay';
+import type { Season } from '../weather/season';
+import { CAST, rodTip } from '../fishing/cast';
+import { DIFFICULTIES, type Difficulty } from '../fishing/difficulty';
+import { DAYTIME, FISH_COUNT, NATIVE_SPECIES, SPECIES_IDS, createFishPopulation, stepFishPopulation, type FishConditions, type SpeciesId } from '../fishing/fish';
+import { createFishing, lureInfo, stepFishing, type FishingContext } from '../fishing/fishing';
+import { DEFAULT_TACKLE, type Tackle } from '../fishing/gear';
+
+const water = new WaterBody(LUNKINJARVI);
+const bottom = new LakeBottom(water, LUNKINJARVI.bounds, LUNKINJARVI_BOTTOM, LUNKINJARVI.reeds, LUNKINJARVI.piers);
+const world = { isWater: (p: Vec2) => water.isWater(p), depthAt: (p: Vec2) => bottom.depthAt(p) };
+
+type Tally = Record<string, Partial<Record<SpeciesId, number>>>;
+export function sim(opts: { tackle: Partial<Tackle>; season: Season; hour: number; seed: number; minutes: number; gear?: number; species?: SpeciesId[]; diff?: Difficulty; extra?: Partial<FishConditions> }) {
+  const dt = 1 / 20;
+  const season = opts.season;
+  const d = daylight(opts.hour, season);
+  const cond: FishConditions = { ...DAYTIME, light: d.light, twilight: d.twilight, season, ...opts.extra };
+  const rng = new Rng(opts.seed);
+  const me = new Rng(opts.seed ^ 0x9e3779b9);
+  const pop = createFishPopulation({ ...world, structures: bottom.structures }, LUNKINJARVI.bounds, rng, FISH_COUNT, opts.species ?? [...NATIVE_SPECIES], season);
+  const diff = DIFFICULTIES[opts.diff ?? 'normal'];
+  const s = createFishing({ ...DEFAULT_TACKLE, ...opts.tackle });
+  if (opts.gear !== undefined) s.gear = opts.gear;
+  const t: Tally = { follow: {}, strike: {}, caught: {}, kg: {} };
+  const add = (k: string, sp: SpeciesId, v = 1) => (t[k]![sp] = (t[k]![sp] ?? 0) + v);
+  let casts = 0;
+  let pos = { x: 0, y: 0 };
+  let heading = 0;
+  const relocate = () => {
+    pos = findLaunchPoint(water, LUNKINJARVI.bounds, () => me.next());
+    const shore = water.closestShorePoint(pos)?.point ?? pos;
+    heading = Math.atan2(pos.y - shore.y, pos.x - shore.x);
+  };
+  relocate();
+  let nextMove = 120;
+  let charge = 0;
+  let aim = pos;
+  let hookedSp: SpeciesId | null = null;
+  for (let time = 0; time < opts.minutes * 60; time += dt) {
+    if (time >= nextMove && s.stage === 'idle') { relocate(); nextMove = time + 120; }
+    const ctx: FishingContext = { tubePos: pos, heading, ...world, structureAt: (p) => bottom.structureAt(p), bottomTypeAt: (p) => bottom.bottomTypeAt(p) };
+    const fe = stepFishPopulation(pop, lureInfo(s, ctx), world, diff, rng, dt, cond);
+    const spOf = (id?: number) => pop.fish.find((f) => f.id === id)?.species;
+    if (fe.follow !== undefined) add('follow', spOf(fe.follow)!);
+    if (fe.strike !== undefined) add('strike', spOf(fe.strike)!);
+    if (s.stage === 'idle' && charge <= 0) {
+      const a = heading + me.range(-1.2, 1.2);
+      const tip = rodTip(pos, heading);
+      aim = { x: tip.x + Math.cos(a) * 20, y: tip.y + Math.sin(a) * 20 };
+      charge = me.range(0.35, 1) * CAST.chargeTime;
+    }
+    const charging = s.stage === 'idle' || s.stage === 'charging';
+    const castHeld = charging && charge > 0 && !(s.stage === 'idle' && s.needRelease);
+    if (s.stage === 'charging') charge -= dt;
+    if (s.hookedId !== null) hookedSp = spOf(s.hookedId) ?? hookedSp;
+    const big = s.strikeBig && s.strikeAge > 0.3;
+    const ev = stepFishing(s, { aim, castHeld, reel: s.stage === 'water', cancel: false, cut: s.stage === 'water' && s.onLand, twitch: big, land: s.landing !== null && s.landing.age > 0.8 } as never, { ...ctx, fish: { pop, diff, rng, strike: fe.strike } }, dt);
+    if (ev.cast !== undefined) { casts++; charge = 0; }
+    if (ev.caught) { const c = ev.caught as { species: SpeciesId; weight: number }; add('caught', c.species); add('kg', c.species, c.weight); }
+  }
+  return { t, casts };
+}
+
+const fmt = (o: Partial<Record<SpeciesId, number>>) => SPECIES_IDS.filter((k) => o[k]).map((k) => `${k} ${Math.round(o[k]! * 10) / 10}`).join(', ');
+
+const SEEDS = [11, 12, 13, 14];
+const LURES: [string, Partial<Tackle>][] = [
+  ['lusikka', { lure: 'spoon' }],
+  ['lippa', { lure: 'spinner', rod: 'light' as never }],
+  ['vaappu', { lure: 'wobbler' }],
+  ['jigi', { lure: 'jig' }],
+];
+
+for (const [name, tackle] of LURES)
+  for (const [label, season, hour] of [['kesäpäivä', 'summer', 13], ['kesäilta', 'summer', 22.3], ['syysaamu', 'autumn', 7.7]] as const) {
+    it(`${name} ${label}`, () => {
+      const tot: Tally = { follow: {}, strike: {}, caught: {}, kg: {} };
+      let casts = 0;
+      for (const seed of SEEDS) {
+        const r = sim({ tackle, season, hour, seed, minutes: 10 });
+        casts += r.casts;
+        for (const k of Object.keys(tot)) for (const [sp, v] of Object.entries(r.t[k]!)) tot[k]![sp as SpeciesId] = (tot[k]![sp as SpeciesId] ?? 0) + v!;
+      }
+      console.log(`${name} ${label} (${casts} heittoa/40 min)\n  seuraa: ${fmt(tot.follow!)}\n  iskee: ${fmt(tot.strike!)}\n  saalis: ${fmt(tot.caught!)}`);
+    }, 300_000);
+  }
