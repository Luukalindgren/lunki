@@ -0,0 +1,339 @@
+// Prototyyppi (#650, jatkotutkimus): sileä moderni ilme pelin kehitysversion päälle.
+// Ajetaan selaimessa kisan alettua: applyModern({ view: 'pov' | 'top' | 'third', look: true }).
+window.applyModern = (opts = {}) => {
+  const g = window.lunki, T = window.THREE, retro = window.retro, r = retro.renderer;
+  const scene = g.scene;
+  const log = [];
+  const byName = (name) => { const out = []; scene.traverse((o) => { if (o.name === name) out.push(o); }); return out; };
+  let sun;
+  scene.traverse((o) => { if (o.isDirectionalLight) sun = o; });
+  let seed = 11;
+  const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
+
+  // --- Kolmannen persoonan kamera lähikuvaan ---
+  if (opts.view === 'third') {
+    const cam = new T.PerspectiveCamera(50, 1280 / 720, 0.1, 6000);
+    const p = g.tube.pos, h = g.tube.heading ?? 0;
+    const f = new T.Vector3(Math.cos(h), 0, -Math.sin(h)), rt = new T.Vector3(-f.z, 0, f.x);
+    const at = new T.Vector3(p.x, 0, -p.y);
+    cam.position.copy(at).addScaledVector(f, 3.6).addScaledVector(rt, 2.6).add(new T.Vector3(0, 1.3, 0));
+    cam.lookAt(at.clone().add(new T.Vector3(0, 1.5, 0)).addScaledVector(f, -1.5));
+    const orig = retro.render.bind(retro);
+    retro.render = (s, c, gr) => {
+      for (const d of byName('sky')) { d.visible = true; d.position.copy(cam.position); }
+      if (g.youMarker) g.youMarker.group.visible = false;
+      if (g.mapOverlay) g.mapOverlay.visible = false;
+      if (g.scenery) g.scenery.visible = true;
+      orig(s, cam, gr);
+    };
+    log.push('third h=' + h);
+  }
+  if (!opts.look) return log;
+
+  // --- Reunanpehmennys ---
+  try {
+    const t = retro.sceneTarget; t.samples = 4; t.texture.minFilter = T.LinearFilter; t.texture.magFilter = T.LinearFilter; t.dispose();
+  } catch (e) { log.push('msaa ' + e.message); }
+
+  // --- Lehvästö kortteina ---
+  const canvasTex = (draw, size = 256) => {
+    const cv = document.createElement('canvas'); cv.width = cv.height = size;
+    draw(cv.getContext('2d'), size);
+    const tex = new T.CanvasTexture(cv); tex.colorSpace = T.SRGBColorSpace; tex.anisotropy = 8;
+    return tex;
+  };
+  const pick = (list) => list[Math.floor(rnd() * list.length)];
+  const leafTex = (cols) => canvasTex((ctx, s) => {
+    for (let i = 0; i < 150; i++) {
+      const a = rnd() * 6.28, d = Math.sqrt(rnd()) * s * 0.4;
+      ctx.save(); ctx.translate(s / 2 + Math.cos(a) * d, s / 2 + Math.sin(a) * d); ctx.rotate(rnd() * 6.28);
+      ctx.fillStyle = pick(cols); ctx.beginPath(); ctx.ellipse(0, 0, s * 0.045, s * 0.026, 0, 0, 6.28); ctx.fill(); ctx.restore();
+    }
+  });
+  const needleTex = (cols) => canvasTex((ctx, s) => {
+    ctx.lineCap = 'round';
+    for (let k = 0; k < 26; k++) {
+      const a0 = rnd() * 6.28, d = Math.sqrt(rnd()) * s * 0.3, cx = s / 2 + Math.cos(a0) * d, cy = s / 2 + Math.sin(a0) * d;
+      for (let i = 0; i < 30; i++) {
+        const a = rnd() * 6.28, l = s * (0.06 + rnd() * 0.07);
+        ctx.strokeStyle = pick(cols); ctx.lineWidth = s * 0.008; ctx.beginPath(); ctx.moveTo(cx, cy); ctx.lineTo(cx + Math.cos(a) * l, cy + Math.sin(a) * l); ctx.stroke();
+      }
+    }
+  });
+  // Kuusen oksa: tyvi vasemmalla, kärki oikealla, havut sivuoksissa.
+  const branchTex = (cols) => canvasTex((ctx, s) => {
+    ctx.lineCap = 'round';
+    for (let i = 0; i < 46; i++) {
+      const t = i / 45, x = s * (0.04 + t * 0.9), w = s * 0.44 * Math.sin(Math.min(1, t * 1.25) * Math.PI * 0.62 + 0.25) * (1 - t * 0.55);
+      for (const side of [-1, 1]) {
+        const ex = x + s * 0.09, ey = s / 2 + side * w * (0.75 + rnd() * 0.3);
+        ctx.strokeStyle = pick(cols); ctx.lineWidth = s * 0.014; ctx.beginPath(); ctx.moveTo(x, s / 2); ctx.lineTo(ex, ey); ctx.stroke();
+        for (let n = 0; n < 16; n++) {
+          const u = rnd(), px = x + (ex - x) * u, py = s / 2 + (ey - s / 2) * u, a = rnd() * 6.28, l = s * 0.05;
+          ctx.strokeStyle = pick(cols); ctx.lineWidth = s * 0.007; ctx.beginPath(); ctx.moveTo(px, py); ctx.lineTo(px + Math.cos(a) * l, py + Math.sin(a) * l); ctx.stroke();
+        }
+      }
+    }
+  });
+  const quads = { pos: [], nor: [], uv: [], col: [] };
+  const resetQuads = () => { quads.pos = []; quads.nor = []; quads.uv = []; quads.col = []; };
+  // Kortti: keskipiste c, akselit u ja v (puolikkaat), valon normaali n ja kirkkaus.
+  const card = (c, u, v, n, shade) => {
+    const corner = (su, sv) => [c[0] + u[0] * su + v[0] * sv, c[1] + u[1] * su + v[1] * sv, c[2] + u[2] * su + v[2] * sv];
+    const P = [corner(-1, -1), corner(1, -1), corner(1, 1), corner(-1, 1)], UV = [[0, 0], [1, 0], [1, 1], [0, 1]];
+    for (const i of [0, 1, 2, 0, 2, 3]) { quads.pos.push(...P[i]); quads.nor.push(...n); quads.uv.push(...UV[i]); quads.col.push(shade, shade, shade); }
+  };
+  const norm = (v) => { const l = Math.hypot(...v) || 1; return [v[0] / l, v[1] / l, v[2] / l]; };
+  const cross = (a, b) => [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]];
+  // Lehvästön pallomainen ryhmä kortteja.
+  const clump = (cx, cy, cz, rad, sy, n, size) => {
+    for (let i = 0; i < n; i++) {
+      const z = rnd() * 2 - 1, a = rnd() * 6.28, q = Math.sqrt(1 - z * z);
+      const d = [q * Math.cos(a), z, q * Math.sin(a)], k = 0.55 + rnd() * 0.45;
+      const c = [cx + d[0] * rad * k, cy + d[1] * rad * sy * k, cz + d[2] * rad * k];
+      const face = norm([d[0] + (rnd() - 0.5) * 0.9, d[1] + (rnd() - 0.5) * 0.9, d[2] + (rnd() - 0.5) * 0.9]);
+      const u = norm(cross(face, [0.3, 1, 0.2])), v = cross(face, u), s = size * (0.75 + rnd() * 0.5);
+      const light = norm([d[0], d[1] + 0.45, d[2]]);
+      card(c, u.map((x) => x * s), v.map((x) => x * s), light, 0.62 + 0.38 * (d[1] * 0.5 + 0.5) * k + (rnd() - 0.5) * 0.08);
+    }
+  };
+  const cardGeo = (aspect) => {
+    const geo = new T.BufferGeometry();
+    const pos = Float32Array.from(quads.pos);
+    for (let i = 0; i < pos.length; i += 3) { pos[i] /= aspect; pos[i + 2] /= aspect; }
+    geo.setAttribute('position', new T.BufferAttribute(pos, 3));
+    geo.setAttribute('normal', new T.BufferAttribute(Float32Array.from(quads.nor), 3));
+    geo.setAttribute('uv', new T.BufferAttribute(Float32Array.from(quads.uv), 2));
+    geo.setAttribute('color', new T.BufferAttribute(Float32Array.from(quads.col), 3));
+    return geo;
+  };
+  // Runko ja lehvästön tumma sisus: sileä, väri verteksissä.
+  const solid = (geo, colorAt, aspect) => {
+    geo = geo.index ? geo.toNonIndexed() : geo;
+    geo.computeVertexNormals();
+    const p = geo.attributes.position, col = new Float32Array(p.count * 3), c = new T.Color();
+    for (let i = 0; i < p.count; i++) { c.set(colorAt(p.getY(i), i)); col[i * 3] = c.r; col[i * 3 + 1] = c.g; col[i * 3 + 2] = c.b; p.setX(i, p.getX(i) / aspect); p.setZ(i, p.getZ(i) / aspect); }
+    geo.setAttribute('color', new T.BufferAttribute(col, 3));
+    const uv = new Float32Array(p.count * 2); geo.setAttribute('uv', new T.BufferAttribute(uv, 2));
+    return geo;
+  };
+  const smooth = (geo) => { const m = window.BGU.mergeVertices(geo.index ? geo : geo); m.computeVertexNormals(); return m; };
+  const mix = (a, b, t) => new T.Color(a).lerp(new T.Color(b), Math.max(0, Math.min(1, t)));
+  const foliageMat = (map) => {
+    const m = new T.MeshLambertMaterial({ map, alphaTest: 0.45, side: T.DoubleSide, vertexColors: true, alphaToCoverage: true });
+    // Kortin takapuoli valaistaan kuten etupuoli: lehvästön valo tulee ryhmän muodosta.
+    m.onBeforeCompile = (sh) => { sh.fragmentShader = sh.fragmentShader.replace('#include <normal_fragment_begin>', '#include <normal_fragment_begin>\n normal = normalize( vNormal );'); };
+    return m;
+  };
+  const solidMat = new T.MeshLambertMaterial({ vertexColors: true });
+  const depthMat = (map) => new T.MeshDepthMaterial({ depthPacking: T.RGBADepthPacking, map, alphaTest: 0.45 });
+
+  const kinds = {
+    spruce: () => {
+      const aspect = 0.45;
+      resetQuads();
+      for (let i = 0; i < 15; i++) {
+        const y = 0.13 + i * 0.057, rad = 0.2 * Math.pow(1 - (y - 0.1) / 0.92, 0.85) + 0.014, n = 8, off = rnd() * 6.28;
+        for (let k = 0; k < n; k++) {
+          const a = off + (k / n) * 6.28 + (rnd() - 0.5) * 0.3, dir = [Math.cos(a), 0, Math.sin(a)], droop = 0.42 + rnd() * 0.25;
+          const u = [dir[0] * Math.cos(droop), -Math.sin(droop), dir[2] * Math.cos(droop)], v = [-dir[2], 0, dir[0]];
+          const len = rad * 0.62, wid = rad * 0.5;
+          const c = [dir[0] * rad * 0.5, y - rad * 0.12, dir[2] * rad * 0.5];
+          card(c, u.map((x) => x * len), v.map((x) => x * wid), norm([dir[0], 0.7, dir[2]]), 0.7 + 0.3 * (i / 14) + (rnd() - 0.5) * 0.1);
+        }
+      }
+      const tex = branchTex(['#2a6a3a', '#327a44', '#3c8a4e', '#245c33']);
+      const core = solid(smooth(new T.ConeGeometry(0.1, 0.86, 12, 6).translate(0, 0.56, 0)), () => 0x1c4628, aspect);
+      const trunk = solid(smooth(new T.CylinderGeometry(0.008, 0.016, 0.3, 8).translate(0, 0.15, 0)), () => 0x4a3a2c, aspect);
+      return { foliage: cardGeo(aspect), tex, solid: window.BGU.mergeGeometries([core, trunk]) };
+    },
+    pine: () => {
+      const aspect = 0.5;
+      resetQuads();
+      const cl = [[0, 0.87, 0, 0.15], [0.1, 0.77, -0.05, 0.12], [-0.11, 0.79, 0.07, 0.12], [0.03, 0.7, 0.1, 0.09], [-0.05, 0.94, -0.03, 0.1], [0.06, 0.66, -0.1, 0.07]];
+      const cores = [];
+      for (const [x, y, z, rad] of cl) {
+        clump(x, y, z, rad, 0.6, 30, rad * 0.62);
+        cores.push(solid(smooth(new T.IcosahedronGeometry(rad * 0.62, 2).scale(1, 0.6, 1).translate(x, y, z)), () => 0x2a5a32, aspect));
+        // Oksa rungosta ryhmään
+        const len = Math.hypot(x, z);
+        if (len > 0.02) cores.push(solid(new T.CylinderGeometry(0.004, 0.006, len, 5).rotateZ(Math.PI / 2).rotateY(-Math.atan2(z, x)).translate(x / 2, y - rad * 0.2, z / 2), () => 0x9a5a36, aspect));
+      }
+      const tex = needleTex(['#3d8244', '#4a964c', '#57a556', '#35733c']);
+      const trunk = solid(smooth(new T.CylinderGeometry(0.008, 0.017, 0.86, 10, 8).translate(0, 0.43, 0)), (y) => mix(0x5e4a3e, 0xb86a3c, (y - 0.2) / 0.35), aspect);
+      return { foliage: cardGeo(aspect), tex, solid: window.BGU.mergeGeometries([trunk, ...cores]) };
+    },
+    birch: () => {
+      const aspect = 0.55;
+      resetQuads();
+      const cl = [[0, 0.68, 0, 0.17, 1.25], [0.09, 0.5, 0.05, 0.12, 1.2], [-0.1, 0.54, -0.06, 0.12, 1.2], [0.02, 0.87, 0.01, 0.1, 1.2], [-0.03, 0.4, 0.09, 0.085, 1.1], [0.05, 0.4, -0.09, 0.08, 1.1]];
+      const cores = [];
+      for (const [x, y, z, rad, sy] of cl) {
+        clump(x, y, z, rad, sy, 34, rad * 0.55);
+        cores.push(solid(smooth(new T.IcosahedronGeometry(rad * 0.55, 2).scale(1, sy, 1).translate(x, y, z)), () => 0x5c9040, aspect));
+      }
+      const tex = leafTex(['#8fc652', '#a2d560', '#7ab044', '#b4e06e', '#86bd4c']);
+      const trunk = solid(smooth(new T.CylinderGeometry(0.006, 0.014, 0.8, 9, 22).translate(0, 0.4, 0)), (y) => (Math.sin(y * 173) * Math.sin(y * 61) > 0.55 ? 0x2c2a28 : 0xe9e7dc), aspect);
+      return { foliage: cardGeo(aspect), tex, solid: window.BGU.mergeGeometries([trunk, ...cores]) };
+    },
