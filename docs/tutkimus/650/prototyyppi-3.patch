+/* A Luonnollinen: eräkartta. Paperi, muste ja korkeuskäyrät. */
+.hud { --u0: 3px !important; font-family: 'Alegreya Sans', sans-serif; font-size: calc(var(--u) * 7); font-weight: 500; line-height: 1.2; color: #f1ead6; text-shadow: none; }
+.hud-panel, .hud-message > span, .hud-notices-stack > .hud-situation {
+  background: rgb(24 38 30 / 82%); border: 1px solid rgb(226 214 180 / 55%); border-radius: calc(var(--u) * 1.5);
+  box-shadow: 0 0 0 calc(var(--u) * 0.8) rgb(24 38 30 / 82%), 0 4px 14px rgb(0 0 0 / 30%); color: #f1ead6;
+}
+.hud-message { font-family: 'Fraunces', serif; font-weight: 700; font-size: calc(var(--u) * 8); }
+.hud-message > span, .hud-notices-stack > .hud-situation { padding: calc(var(--u) * 2.5) calc(var(--u) * 6); }
+.hud-notices-stack > .hud-situation { color: #f3d98a; font-size: calc(var(--u) * 7.4); font-weight: 700; }
+.hud-timer { font-family: 'Fraunces', serif; font-weight: 700; font-size: calc(var(--u) * 9); }
+.screen { font-family: 'Alegreya Sans', sans-serif; background-color: #1c2a22; }
+.screen-panel {
+  color: #24362a; font-size: 18px; --panel-py: 30px; --panel-px: 38px; border: none; border-radius: 4px;
+  background:
+    repeating-radial-gradient(ellipse at 18% 115%, transparent 0 21px, rgb(120 96 52 / 16%) 21px 22px),
+    repeating-radial-gradient(ellipse at 92% -10%, transparent 0 27px, rgb(120 96 52 / 13%) 27px 28px),
+    radial-gradient(ellipse at 50% 40%, #f4ecd6 0%, #eadfc0 70%, #d9caa2 100%);
+  box-shadow: 0 0 0 1px #8b7a52, 0 0 0 7px #efe5c8, 0 0 0 8px #8b7a52, 0 26px 60px rgb(0 0 0 / 55%);
+}
+.screen-panel h1 { font-family: 'Fraunces', serif; font-weight: 700; font-size: min(62px, 12vw); letter-spacing: 1px; color: #1f4a30; text-shadow: none; }
+.screen-panel h1::after { content: '60°47′ P · 23°44′ I · TAMMELA'; display: block; font-family: 'Alegreya Sans', sans-serif; font-size: 13px; letter-spacing: 4px; color: #8a5a2a; margin-top: 4px; }
+.screen-panel h2 { font-family: 'Fraunces', serif; font-size: 32px; color: #1f4a30; }
+.screen-panel .subtitle { color: #6a5a34; font-size: 19px; font-style: italic; }
+.screen-panel p, .screen-panel .choice-label { color: #4a4a36; }
+.screen button { font-family: inherit; font-size: 19px; font-weight: 700; color: #24362a; background: rgb(255 252 240 / 55%); border: 1.5px solid #5a6a4a; border-radius: 3px; box-shadow: none !important; padding: 10px 18px; letter-spacing: 0.3px; }
+.screen button.primary { background: #8a2a22; border-color: #5c1a14; color: #f6eed8; }
