+/* Prototyyppi (#650): moderni teema HUDiin ja valikoihin. */
+.fps-meter { display: none !important; }
+.hud {
+  --u0: 3px !important;
+  font-family: 'Inter', system-ui, sans-serif;
+  font-size: calc(var(--u) * 6.4);
+  font-weight: 500;
+  line-height: 1.25;
+  text-shadow: 0 1px 2px rgb(0 0 0 / 55%);
+}
+.hud-panel {
+  background: rgb(16 24 32 / 52%);
+  border: 1px solid rgb(255 255 255 / 16%);
+  border-radius: calc(var(--u) * 3.5);
+  -webkit-backdrop-filter: blur(12px);
+  backdrop-filter: blur(12px);
+  box-shadow: 0 6px 20px rgb(0 0 0 / 22%);
+}
+.hud-timer { font-weight: 700; font-variant-numeric: tabular-nums; }
+.screen {
+  font-family: 'Inter', system-ui, sans-serif;
+  background: rgb(8 14 20 / 30%);
+  -webkit-backdrop-filter: blur(5px);
+  backdrop-filter: blur(5px);
+}
+.screen-panel {
+  background: rgb(20 28 38 / 84%);
+  border: 1px solid rgb(255 255 255 / 12%);
+  border-radius: 22px;
+  box-shadow: 0 24px 70px rgb(0 0 0 / 50%);
+  font-size: 16px;
+  --panel-py: 28px;
+  --panel-px: 32px;
+}
+.screen-panel h1 {
+  font-family: 'Inter Display', 'Inter', sans-serif;
+  font-size: min(52px, 11vw);
+  font-weight: 800;
+  letter-spacing: 0.5px;
+  color: #fff;
+  text-shadow: none;
+}
+.screen-panel h2 { font-size: 28px; font-weight: 700; color: #fff; }
+.screen-panel .subtitle { color: #9fd3e6; font-size: 16px; }
+.screen button {
+  font-family: inherit;
+  font-size: 16px;
+  font-weight: 500;
+  color: #eef2f3;
+  background: rgb(255 255 255 / 7%);
+  border: 1px solid rgb(255 255 255 / 14%);
+  border-radius: 12px;
+  box-shadow: none;
+  padding: 11px 18px;
+}
+.screen button.primary { background: #2f8fd0; border-color: transparent; color: #fff; font-weight: 600; }
+.screen button.selected { background: rgb(47 143 208 / 28%); border-color: #58b4ee; }
+.screen button.quiet { background: transparent; }
+.hud-message { font-size: calc(var(--u) * 7.6); font-weight: 600; color: #fff; }
+.hud-message > span {
+  background: rgb(16 24 32 / 58%);
+  border: 1px solid rgb(255 255 255 / 16%);
+  border-radius: calc(var(--u) * 3.5);
+  padding: calc(var(--u) * 2) calc(var(--u) * 5);
+  -webkit-backdrop-filter: blur(12px);
+  backdrop-filter: blur(12px);
+}
+.hud-notices-stack > .hud-situation {
+  background: rgb(16 24 32 / 58%);
+  border: 1px solid rgb(255 255 255 / 16%);
+  border-radius: calc(var(--u) * 3.5);
+  color: #ffe9a8;
+  font-size: calc(var(--u) * 7);
+  padding: calc(var(--u) * 2.5) calc(var(--u) * 5);
+  -webkit-backdrop-filter: blur(12px);
+  backdrop-filter: blur(12px);
+}
+.screen button { box-shadow: none !important; }
+.screen-panel h3.settings-section { color: #9fd3e6; font-size: 13px; font-weight: 600; letter-spacing: 1.2px; text-transform: uppercase; }
+.screen-panel p { font-size: 14px; }
